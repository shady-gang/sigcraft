#version 450
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_maximal_reconvergence : enable
#extension GL_EXT_debug_printf : enable
#extension GL_GOOGLE_include_directive : require

#define TASK_SHADER_MESHING 1

#include "frustum.glsl"
#include "chunk_data.glsl"
#if TASK_SHADER_MESHING
#include "neighboring_chunks.glsl"
#endif
#include "voxel_range_meshlet.glsl"
#include "voxel_mesh.glsl"

#include "heatmap.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(triangles, max_vertices = MAX_VERTS, max_primitives = MAX_PRIMS) out;

layout(scalar, push_constant) uniform T {
    mat4 matrix;
    Frustum frustum;
    ivec3 camera_chunk_pos;
    vec3 camera_pos;
    vec3 camera_dir;
    float time;
    int debug;
    int visible_chunk_radius;
    uint64_t visible_chunks;
    uint64_t xxx;
} push_constants;

struct Payload {
    ivec3 chunk_position;
#if TASK_SHADER_MESHING
    VoxelMeshlets meshlets;
#else
    uint64_t tmp;
#endif
};

taskPayloadSharedEXT Payload ts_in;

perprimitiveEXT out gl_MeshPerPrimitiveEXT {
    int gl_PrimitiveID;
    //int gl_Layer;
} gl_MeshPrimitivesEXT[];

// layout(location = 0)
// perprimitiveEXT out vec3 colorOut[];
//
// layout(location = 1)
// perprimitiveEXT out vec3 normalOut[];

shared int vertex_buffer_length;
shared int primitive_buffer_length;

int allocate_vertex_buffer_space(int size) {
    int offset;
    if (gl_SubgroupInvocationID == 0) {
        offset = atomicAdd(vertex_buffer_length, size);
    }
    offset = subgroupShuffle(offset, 0);
    if (offset + size > MAX_VERTS)
        return -1;
    return offset;
}

int allocate_primitive_buffer_space(int size) {
    int offset;
    if (gl_SubgroupInvocationID == 0) {
        offset = atomicAdd(primitive_buffer_length, size);
    }
    offset = subgroupShuffle(offset, 0);
    if (offset + size > MAX_PRIMS)
        return -1;
    return offset;
}

uint safe_prim_idx(uint idx, uint num_prims) {
    return idx;
    //return idx % num_prims;
}

uint safe_vert_idx(uint idx, uint num_verts) {
    return idx;
    //return idx % num_verts;
}

void main() {
#if TASK_SHADER_MESHING
    MeshletPayload meshlet = ts_in.meshlets.meshlets[gl_WorkGroupID.x];
#else
    MeshletPayload meshlet = VoxelMeshletsRef(ts_in.tmp).ref.meshlets[gl_WorkGroupID.x];
#endif
    SetMeshOutputsEXT(meshlet.num_verts, meshlet.num_prims);

    // always zero-out the output primitives array first
    //for (uint i = 0; i < meshlet.num_prims; i+= gl_WorkGroupSize.x) {
    //    uint idx = i + gl_LocalInvocationIndex;
    //    if (idx < meshlet.num_prims) {
    //        gl_MeshPrimitivesEXT[idx].gl_PrimitiveID = int(666);
    //        //gl_PrimitiveTriangleIndicesEXT[idx] = uvec3(0,0,0);
    //    }
    //}
    vertex_buffer_length = 0;
    primitive_buffer_length = 0;
    barrier();

    int start = int(int16_t(meshlet.start));
    int end = meshlet.end;

    if (start < 0 || end > 4096) {
        debugPrintfEXT("too much sauce %d, %d\n", start, end);
        return;    
    }

    if (start >= end) {
        debugPrintfEXT("start >= end %d, %d\n", start, end);
        return;
    }

    //int window_length = end - start;
    int anti_hang = 256;
    for (int scan_idx = start; scan_idx < end; scan_idx += int(gl_WorkGroupSize.x)) {
        uint block_idx = scan_idx + gl_LocalInvocationIndex;
        if (block_idx < end && block_idx < 4096) {
            uvec3 block_pos;
            decode_block_idx(block_idx, block_pos);

            vec3 color = vec3(fract(ts_in.chunk_position.x * 7.777 + start * 0.5231), fract(ts_in.chunk_position.y * 7.777 + start * 0.252102), fract(ts_in.chunk_position.z * 7.777 + start * 0.333));

#if TASK_SHADER_MESHING
            uint faces = uint(ts_in.meshlets.faces[encode_chunkcoord(block_pos, 0)]);
#else
            uint faces = uint(VoxelMeshletsRef(ts_in.tmp).ref.faces[encode_chunkcoord(block_pos, 0)]);
#endif
            uint vertices = uint(face_mask_to_vertex_mask(int(faces)));
            uint num_vertices = bitCount(vertices);
            int num_faces = bitCount(faces) * 2;

            int new_vertices = subgroupAdd(int(num_vertices));
            int new_faces = subgroupAdd(num_faces);

            int allocated_vertex_space = allocate_vertex_buffer_space(new_vertices);
            int allocated_primitive_space = allocate_primitive_buffer_space(new_faces);

            if (allocated_vertex_space < 0 || allocated_primitive_space < 0) {
            //    if (primitive_buffer_length <= 256 && vertex_buffer_length <= 256)
            //    debugPrintfEXT("CP [%d %d %d] tid: %d primitive_buffer_length: %d vertex_buffer_length: %d base_vertex_id: %d primitive_idx: %d new_vertices: %d new faces: %d old_vertex_buffer_length: %d num_vertices: %d num_faces: %d\n",
            //        ts_in.chunk_position.x, ts_in.chunk_position.y, ts_in.chunk_position.z, gl_SubgroupInvocationID,
            //        primitive_buffer_length, vertex_buffer_length, base_vertex_id, primitive_idx, new_vertices, new_faces, old_vertex_buffer_length, num_vertices, num_faces);
            //    return;
            }

            uint base_vertex_id = int(allocated_vertex_space + subgroupExclusiveAdd(num_vertices));
            uint primitive_idx = int(allocated_primitive_space + subgroupExclusiveAdd(num_faces));

            if (num_vertices > 0) {
                uint v[8];
                uint v_idx = 0;
                for (int i = 0; i < 8; i++) {
                    if (((vertices >> i) & 0x1) != 0) {
                        v[i] = base_vertex_id + v_idx++;
                        gl_MeshVerticesEXT[safe_vert_idx(v[i], meshlet.num_verts)].gl_Position = push_constants.matrix * vec4(vec3(ts_in.chunk_position) + vec3(block_pos) + vertex_offsets[i], 1.0);
                        // vertex_offsets
                    }
                }

                uint base_primitive_idx = (gl_WorkGroupID.x << 20) | ((block_pos.x | (block_pos.z << 4) | (block_pos.y << 8)) << 3);
                //uint base_primitive_idx = ((start >> 5) << 20) | ((block_pos.x | (block_pos.z << 4) | (block_pos.y << 8)) << 3);

                if (push_constants.debug == 1) {
                    base_primitive_idx = (end - start) << 3;
                }
                if (push_constants.debug == 2) {
                    base_primitive_idx = (meshlet.num_prims) << 3;
                }
                if (push_constants.debug == 3) {
                    base_primitive_idx = (meshlet.num_verts) << 3;
                }

                if ((faces & 0x1) != 0) {
                    //colorOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = color;
                    //normalOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = vec3(0, 1, 0);
                    gl_MeshPrimitivesEXT[safe_prim_idx(primitive_idx, meshlet.num_prims)].gl_PrimitiveID = int(base_primitive_idx | 0);
                    gl_PrimitiveTriangleIndicesEXT[safe_prim_idx(primitive_idx++, meshlet.num_prims)] = uvec3(v[4], v[7], v[5]);
                    //colorOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = color;
                    //normalOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = vec3(0, 1, 0);
                    gl_MeshPrimitivesEXT[safe_prim_idx(primitive_idx, meshlet.num_prims)].gl_PrimitiveID = int(base_primitive_idx | 0);
                    gl_PrimitiveTriangleIndicesEXT[safe_prim_idx(primitive_idx++, meshlet.num_prims)] = uvec3(v[4], v[6], v[7]);
                }
                if ((faces & 0x2) != 0) {
                    //colorOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = color;
                    //normalOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = vec3(0, -1, 0);
                    gl_MeshPrimitivesEXT[safe_prim_idx(primitive_idx, meshlet.num_prims)].gl_PrimitiveID = int(base_primitive_idx | 1);
                    gl_PrimitiveTriangleIndicesEXT[safe_prim_idx(primitive_idx++, meshlet.num_prims)] = uvec3(v[0], v[3], v[2]);
                    //colorOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = color;
                    //normalOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = vec3(0, -1, 0);
                    gl_MeshPrimitivesEXT[safe_prim_idx(primitive_idx, meshlet.num_prims)].gl_PrimitiveID = int(base_primitive_idx | 1);
                    gl_PrimitiveTriangleIndicesEXT[safe_prim_idx(primitive_idx++, meshlet.num_prims)] = uvec3(v[0], v[1], v[3]);
                }
                if ((faces & 0x4) != 0) {
                    //colorOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = color;
                    //normalOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = vec3(0, 0, 1);
                    gl_MeshPrimitivesEXT[safe_prim_idx(primitive_idx, meshlet.num_prims)].gl_PrimitiveID = int(base_primitive_idx | 2);
                    gl_PrimitiveTriangleIndicesEXT[safe_prim_idx(primitive_idx++, meshlet.num_prims)] = uvec3(v[1], v[5], v[7]);
                    //colorOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = color;
                    //normalOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = vec3(0, 0, 1);
                    gl_MeshPrimitivesEXT[safe_prim_idx(primitive_idx, meshlet.num_prims)].gl_PrimitiveID = int(base_primitive_idx | 2);
                    gl_PrimitiveTriangleIndicesEXT[safe_prim_idx(primitive_idx++, meshlet.num_prims)] = uvec3(v[1], v[7], v[3]);
                }
                if ((faces & 0x8) != 0) {
                    //colorOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = color;
                    //normalOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = vec3(0, 0, -1);
                    gl_MeshPrimitivesEXT[safe_prim_idx(primitive_idx, meshlet.num_prims)].gl_PrimitiveID = int(base_primitive_idx | 3);
                    gl_PrimitiveTriangleIndicesEXT[safe_prim_idx(primitive_idx++, meshlet.num_prims)] = uvec3(v[0], v[6], v[4]);
                    //colorOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = color;
                    //normalOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = vec3(0, 0, -1);
                    gl_MeshPrimitivesEXT[safe_prim_idx(primitive_idx, meshlet.num_prims)].gl_PrimitiveID = int(base_primitive_idx | 3);
                    gl_PrimitiveTriangleIndicesEXT[safe_prim_idx(primitive_idx++, meshlet.num_prims)] = uvec3(v[0], v[2], v[6]);
                }
                if ((faces & 0x10) != 0) {
                    //colorOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = color;
                    //normalOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = vec3(1, 0, 0);
                    gl_MeshPrimitivesEXT[safe_prim_idx(primitive_idx, meshlet.num_prims)].gl_PrimitiveID = int(base_primitive_idx | 4);
                    gl_PrimitiveTriangleIndicesEXT[safe_prim_idx(primitive_idx++, meshlet.num_prims)] = uvec3(v[2], v[3], v[7]);
                    //colorOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = color;
                    //normalOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = vec3(1, 0, 0);
                    gl_MeshPrimitivesEXT[safe_prim_idx(primitive_idx, meshlet.num_prims)].gl_PrimitiveID = int(base_primitive_idx | 4);
                    gl_PrimitiveTriangleIndicesEXT[safe_prim_idx(primitive_idx++, meshlet.num_prims)] = uvec3(v[2], v[7], v[6]);
                }
                if ((faces & 0x20) != 0) {
                    //colorOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = color;
                    //normalOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = vec3(-1, 0, 0);
                    gl_MeshPrimitivesEXT[safe_prim_idx(primitive_idx, meshlet.num_prims)].gl_PrimitiveID = int(base_primitive_idx | 5);
                    gl_PrimitiveTriangleIndicesEXT[safe_prim_idx(primitive_idx++, meshlet.num_prims)] = uvec3(v[0], v[5], v[1]);
                    //colorOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = color;
                    //normalOut[safe_prim_idx(primitive_idx, meshlet.num_prims)] = vec3(-1, 0, 0);
                    gl_MeshPrimitivesEXT[safe_prim_idx(primitive_idx, meshlet.num_prims)].gl_PrimitiveID = int(base_primitive_idx | 5);
                    gl_PrimitiveTriangleIndicesEXT[safe_prim_idx(primitive_idx++, meshlet.num_prims)] = uvec3(v[0], v[4], v[5]);
                }
            }
        } else {
            //break;
        }
//break;
    }

    //barrier();
    //if (gl_SubgroupInvocationID == 0) {
        if (primitive_buffer_length != meshlet.num_prims)
            debugPrintfEXT("OH NO num prims %d != %d, num verts %d vs %d, meshlet %d, range=[%d %d]\n", primitive_buffer_length, meshlet.num_prims, vertex_buffer_length, meshlet.num_verts, gl_WorkGroupID.x, start, end);
    //}
}