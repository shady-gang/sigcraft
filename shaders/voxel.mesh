        }
    }

        barrier();

        while (true) {
            //barrier();
            uint primitive_idx = atomicAdd(primitive_counter, 1);
            if (primitive_idx < MAX_TRIS)
                gl_PrimitiveTriangleIndicesEXT[primitive_idx] = uvec3(0,0,0);
            else
                break;
        }*/

    // colorOut[gl_LocalInvocationIndex * 3 + 1] = vec4(color, 1.0);
    // colorOut[gl_LocalInvocationIndex * 3 + 2] = vec4(color, 1.0);
}