#version 450
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_maximal_reconvergence : enable
#extension GL_EXT_debug_printf : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#define MAX_VERTS 64
#define MAX_PRIMS 126

layout(triangles, max_vertices = MAX_VERTS, max_primitives = MAX_PRIMS) out;

layout(scalar, buffer_reference) buffer VoxelDataRef {
  uint data[];
};

struct ChunkSections {
    VoxelDataRef sections[24];
};

layout(scalar, buffer_reference) buffer VisibleChunksArrayRef {
    ChunkSections visible[];
};

// sizeof = 64
struct SubChunkTmp {
    uint8_t faces[64];
};

layout(scalar, buffer_reference) buffer SubChunkTmpRef {
    SubChunkTmp ref;
};

// sizeof = 4096
struct ChunkTmpSection {
    SubChunkTmp subchunks[64];
};

// sizeof = 98304
struct ChunkTmpSections {
    ChunkTmpSection sections[24];
};

layout(scalar, buffer_reference) readonly buffer ChunkTmpRef {
    ChunkTmpSections visible[];
};

layout(scalar, push_constant) uniform T {
    mat4 matrix;
    float time;
    ivec3 camera_chunk_pos;
    int debug;
    int visible_chunk_radius;
    VisibleChunksArrayRef visible_chunks;
    ChunkTmpRef tmp;
} push_constants;

struct MeshletPayload {
    uint16_t start;
    uint16_t end;
    uint8_t num_verts;
    uint8_t num_prims;
};

struct Payload {
    ivec3 chunk_position;
    uint64_t tmp;
    // with 4x4x4 subchunks, at most 32 blocks so 256 vertices and 384 faces, so 4 meshlets then ?
    MeshletPayload meshlets[4];
};

taskPayloadSharedEXT Payload ts_in;

layout(location = 0)
perprimitiveEXT out vec3 colorOut[];

layout(location = 1)
perprimitiveEXT out vec3 normalOut[];

#define CUNK_CHUNK_MAX_HEIGHT 384
#define CUNK_CHUNK_SIZE 16

uint encode_morton(uint x, uint y, uint z) {
    uint acc = 0;
    for (uint bit = 0; bit < 4; bit++) {
        uint xb = (x >> bit) & 0x1u;
        uint yb = (y >> bit) & 0x1u;
        uint zb = (z >> bit) & 0x1u;
        acc |= (zb << 2 | yb << 1 | xb << 0) << (3 * bit);
    }
    return acc;
}

void decode_morton(uint xyz, out uint x, out uint y, out uint z) {
    x = 0;
    y = 0;
    z = 0;
    for (uint bit = 0; bit < 4; bit++) {
        uint xyzb = (xyz >> (3 * bit)) & 0x7;
        uint xb = xyzb & 0x1;
        uint yb = (xyzb >> 1) & 0x1;
        uint zb = (xyzb >> 2) & 0x1;
        x |= (xb << bit);
        y |= (yb << bit);
        z |= (zb << bit);
    }
}

const uint lod_res[] = { 16, 8, 4, 2, 1 };
const uint lod_offsets[] = { 0, 4096, 4608, 4672, 4680, 4681 };

uint encode_chunkcoord(uint x, uint y, uint z, uint lod) {
    return lod_offsets[lod] + encode_morton(x, y, z);
}

uint encode_chunkcoord(uvec3 v, uint lod) {
    return encode_chunkcoord(v.x, v.y, v.z, lod);
}

void decode_block_idx(uint idx, out uvec3 block_pos) {
    decode_morton(idx, block_pos.x, block_pos.y, block_pos.z);
}

vec3 lod2color(int lod) {
    if (lod == 4)
        return vec3(0.0, 0.0, 1.0);
    if (lod == 3)
        return vec3(0.0, 1.0, 1.0);
    if (lod == 2)
        return vec3(1.0, 1.0, 0.0);
    if (lod == 1)
        return vec3(1.0, 0.75, 0.0);
    return vec3(1.0, 0.0, 0.0);
}

vec3 heatmap(float lod) {
    if (lod < 2)
        return vec3(0.0, 0.0, 1.0);
    if (lod < 4)
        return vec3(0.0, 1.0, 1.0);
    if (lod < 8)
        return vec3(1.0, 1.0, 0.0);
    if (lod < 16)
        return vec3(1.0, 0.75, 0.0);
    return vec3(1.0, 0.0, 0.0);
}

shared int vertex_buffer_length;
shared int primitive_buffer_length;

int allocate_vertex_buffer_space(int size) {
    int offset;
    if (gl_SubgroupInvocationID == 0) {
        offset = atomicAdd(vertex_buffer_length, size);
    }
    offset = subgroupShuffle(offset, 0);
    if (offset + size > MAX_VERTS)
        return -1;
    return offset;
}

int allocate_primitive_buffer_space(int size) {
    int offset;
    if (gl_SubgroupInvocationID == 0) {
        offset = atomicAdd(primitive_buffer_length, size);
    }
    offset = subgroupShuffle(offset, 0);
    if (offset + size > MAX_PRIMS)
        return -1;
    return offset;
}

uint8_t face_mask_to_vertex_mask(int faces) {
    int bit_0 = 0x1;
    int bit_1 = 0x2;
    int bit_2 = 0x4;
    int bit_3 = 0x8;
    int bit_4 = 0x10;
    int bit_5 = 0x20;
    int bit_6 = 0x40;
    int bit_7 = 0x80;
    int result = 0;
    if ((faces & 0x1) != 0) {
        result |= bit_4 | bit_5 | bit_6 | bit_7;
    }
    if ((faces & 0x2) != 0) {
        result |= bit_0 | bit_1 | bit_2 | bit_3;
    }
    if ((faces & 0x4) != 0) {
        result |= bit_1 | bit_3 | bit_5 | bit_7;
    }
    if ((faces & 0x8) != 0) {
        result |= bit_0 | bit_2 | bit_4 | bit_6;
    }
    if ((faces & 0x10) != 0) {
        result |= bit_2 | bit_3 | bit_6 | bit_7;
    }
    if ((faces & 0x20) != 0) {
        result |= bit_0 | bit_1 | bit_4 | bit_5;
    }
    return uint8_t(result);
}

const vec3 vertex_offsets[8] = {
    vec3(0, 0, 0),
    vec3(0, 0, 1),
    vec3(1, 0, 0),
    vec3(1, 0, 1),
    vec3(0, 1, 0),
    vec3(0, 1, 1),
    vec3(1, 1, 0),
    vec3(1, 1, 1),
};

void main() {
    MeshletPayload meshlet = ts_in.meshlets[gl_WorkGroupID.x];
    SetMeshOutputsEXT(meshlet.num_verts, meshlet.num_prims);

    // always zero-out the output primitives array first
    for (uint i = 0; i < meshlet.num_prims; i+= gl_WorkGroupSize.x) {
        uint idx = i + gl_LocalInvocationIndex;
        if (idx < meshlet.num_prims) {
            gl_PrimitiveTriangleIndicesEXT[idx] = uvec3(0,0,0);
        }
    }
    vertex_buffer_length = 0;
    primitive_buffer_length = 0;
    barrier();

    int start = meshlet.start;
    int end = meshlet.end;

    if (start >= end)
        return;

    //int window_length = end - start;
    for (int scan_idx = start; scan_idx < end; scan_idx += int(gl_WorkGroupSize.x)) {
        uint block_idx = scan_idx + gl_LocalInvocationIndex;
        if (block_idx < end && block_idx < 4096) {
            uvec3 block_pos;
            decode_block_idx(block_idx, block_pos);

            vec3 color = vec3(fract(ts_in.chunk_position.x * 7.777 + start * 0.5231), fract(ts_in.chunk_position.y * 7.777 + start * 0.252102), fract(ts_in.chunk_position.z * 7.777 + start * 0.333));

            uint faces = uint(SubChunkTmpRef(ts_in.tmp).ref.faces[encode_chunkcoord(block_pos % 4, 0) % 64]);
            uint vertices = uint(face_mask_to_vertex_mask(int(faces)));
            uint num_vertices = bitCount(vertices);
            int num_faces = bitCount(faces) * 2;

            int new_vertices = subgroupAdd(int(num_vertices));
            int new_faces = subgroupAdd(num_faces);

            int allocated_vertex_space = allocate_vertex_buffer_space(new_vertices);
            int allocated_primitive_space = allocate_primitive_buffer_space(new_faces);

            if (allocated_vertex_space < 0 || allocated_primitive_space < 0) {
            //    if (primitive_buffer_length <= 256 && vertex_buffer_length <= 256)
            //    debugPrintfEXT("CP [%d %d %d] tid: %d primitive_buffer_length: %d vertex_buffer_length: %d base_vertex_id: %d primitive_idx: %d new_vertices: %d new faces: %d old_vertex_buffer_length: %d num_vertices: %d num_faces: %d\n",
            //        ts_in.chunk_position.x, ts_in.chunk_position.y, ts_in.chunk_position.z, gl_SubgroupInvocationID,
            //        primitive_buffer_length, vertex_buffer_length, base_vertex_id, primitive_idx, new_vertices, new_faces, old_vertex_buffer_length, num_vertices, num_faces);
                return;
            }

            uint base_vertex_id = int(allocated_vertex_space + subgroupExclusiveAdd(num_vertices));
            uint primitive_idx = int(allocated_primitive_space + subgroupExclusiveAdd(num_faces));

            if (num_vertices > 0) {
                uint v[8];
                uint v_idx = 0;
                for (int i = 0; i < 8; i++) {
                    if (((vertices >> i) & 0x1) != 0) {
                        v[i] = base_vertex_id + v_idx++;
                        gl_MeshVerticesEXT[v[i]].gl_Position = push_constants.matrix * vec4(vec3(ts_in.chunk_position) + vec3(block_pos) + vertex_offsets[i], 1.0);
                        // vertex_offsets
                    }
                }

                if ((faces & 0x1) != 0) {
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, 1, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v[4], v[7], v[5]);
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, 1, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v[4], v[6], v[7]);
                }
                if ((faces & 0x2) != 0) {
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, -1, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v[0], v[3], v[2]);
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, -1, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v[0], v[1], v[3]);
                }
                if ((faces & 0x4) != 0) {
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, 0, 1);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v[1], v[5], v[7]);
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, 0, 1);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v[1], v[7], v[3]);
                }
                if ((faces & 0x8) != 0) {
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, 0, -1);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v[0], v[6], v[4]);
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, 0, -1);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v[0], v[2], v[6]);
                }
                if ((faces & 0x10) != 0) {
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(1, 0, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v[2], v[3], v[7]);
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(1, 0, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v[2], v[7], v[6]);
                }
                if ((faces & 0x20) != 0) {
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(-1, 0, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v[0], v[5], v[1]);
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(-1, 0, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v[0], v[4], v[5]);
                }
            }
        } else {
            break;
        }
//break;
    }
}