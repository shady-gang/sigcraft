#version 450
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_maximal_reconvergence : enable
#extension GL_EXT_debug_printf : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(triangles, max_vertices = 256, max_primitives = 256) out;

layout(scalar, buffer_reference) buffer VoxelDataRef {
  uint data[];
};

struct ChunkSections {
    VoxelDataRef sections[24];
};

layout(scalar, buffer_reference) buffer VisibleChunksArrayRef {
    ChunkSections visible[];
};

layout(scalar, push_constant) uniform T {
    mat4 matrix;
    float time;
    ivec3 camera_chunk_pos;
    int debug;
    int visible_chunk_radius;
    VisibleChunksArrayRef visible_chunks;
} push_constants;

struct Payload {
    ivec3 chunk_position;
    uint8_t faces[4096];
    uint16_t start[256]; /* 96 */
    uint16_t end[256]; /* 96 */
};

taskPayloadSharedEXT Payload ts_in;

layout(location = 0)
perprimitiveEXT out vec3 colorOut[];

layout(location = 1)
perprimitiveEXT out vec3 normalOut[];

#define CUNK_CHUNK_MAX_HEIGHT 384
#define CUNK_CHUNK_SIZE 16

const uint lod_res[] = { 16, 8, 4, 2, 1 };
const uint lod_offsets[] = { 0, 4096, 4608, 4672, 4680, 4681 };

uint encode_chunkcoord(uint x, uint y, uint z, uint lod) {
    return lod_offsets[lod] + x + (y + z * lod_res[lod]) * lod_res[lod];
}

uint encode_chunkcoord(uvec3 v, uint lod) {
    return encode_chunkcoord(v.x, v.y, v.z, lod);
}

void decode_block_idx(uint idx, out uvec3 block_pos) {
    block_pos.x = idx % 16;
    block_pos.y = (idx / 16) % 16;
    block_pos.z = idx / 256;
}

vec3 lod2color(int lod) {
    if (lod == 4)
        return vec3(0.0, 0.0, 1.0);
    if (lod == 3)
        return vec3(0.0, 1.0, 1.0);
    if (lod == 2)
        return vec3(1.0, 1.0, 0.0);
    if (lod == 1)
        return vec3(1.0, 0.75, 0.0);
    return vec3(1.0, 0.0, 0.0);
}

vec3 heatmap(float lod) {
    if (lod < 2)
        return vec3(0.0, 0.0, 1.0);
    if (lod < 4)
        return vec3(0.0, 1.0, 1.0);
    if (lod < 8)
        return vec3(1.0, 1.0, 0.0);
    if (lod < 16)
        return vec3(1.0, 0.75, 0.0);
    return vec3(1.0, 0.0, 0.0);
}

shared int vertex_buffer_length;
shared int primitive_buffer_length;

int allocate_vertex_buffer_space(int size) {
    int offset;
    if (gl_SubgroupInvocationID == 0) {
        offset = atomicAdd(vertex_buffer_length, size);
    }
    offset = subgroupShuffle(offset, 0);
    if (offset >= 256)
        return -1;
    return offset;
}

int allocate_primitive_buffer_space(int size) {
    int offset;
    if (gl_SubgroupInvocationID == 0) {
        offset = atomicAdd(primitive_buffer_length, size);
    }
    offset = subgroupShuffle(offset, 0);
    if (offset >= 256)
        return -1;
    return offset;
}

void main() {
    SetMeshOutputsEXT(256, 256);

    // always zero-out the output primitives array first
    for (int i = 0; i < 256 / gl_WorkGroupSize.x; i++)
        gl_PrimitiveTriangleIndicesEXT[i * gl_WorkGroupSize.x + gl_LocalInvocationIndex] = uvec3(0,0,0);
    vertex_buffer_length = 0;
    primitive_buffer_length = 0;
    barrier();

    int start = ts_in.start[gl_WorkGroupID.x];
    int end = ts_in.end[gl_WorkGroupID.x];

    if (start >= end)
        return;

    //int window_length = end - start;
    for (int scan_idx = start; scan_idx < end; scan_idx += int(gl_WorkGroupSize.x)) {
        uint block_idx = scan_idx + gl_LocalInvocationIndex;
        if (block_idx < end && block_idx < 4096) {
            uvec3 block_pos;
            decode_block_idx(block_idx, block_pos);

            vec3 color = vec3(fract(16 * ts_in.chunk_position.x * 7.777 + start * 0.5231), fract(16 * ts_in.chunk_position.y * 7.777 + start * 0.252102), fract(16 * ts_in.chunk_position.z * 7.777 + start * 0.333));

            uint faces = uint(ts_in.faces[block_idx]);
            uint num_vertices = faces == 0 ? 0 : 8;
            int num_faces = bitCount(faces) * 2;

            int new_vertices = subgroupAdd(int(num_vertices));
            int new_faces = subgroupAdd(num_faces);

            int allocated_vertex_space = allocate_vertex_buffer_space(new_vertices);
            int allocated_primitive_space = allocate_primitive_buffer_space(new_faces);

            if (allocated_vertex_space < 0 || allocated_primitive_space < 0) {
            //    if (primitive_buffer_length <= 256 && vertex_buffer_length <= 256)
            //    debugPrintfEXT("CP [%d %d %d] tid: %d primitive_buffer_length: %d vertex_buffer_length: %d base_vertex_id: %d primitive_idx: %d new_vertices: %d new faces: %d old_vertex_buffer_length: %d num_vertices: %d num_faces: %d\n",
            //        ts_in.chunk_position.x, ts_in.chunk_position.y, ts_in.chunk_position.z, gl_SubgroupInvocationID,
            //        primitive_buffer_length, vertex_buffer_length, base_vertex_id, primitive_idx, new_vertices, new_faces, old_vertex_buffer_length, num_vertices, num_faces);
                return;
            }

            uint base_vertex_id = int(allocated_vertex_space + subgroupExclusiveAdd(num_vertices));
            uint primitive_idx = int(allocated_primitive_space + subgroupExclusiveAdd(num_faces));

            if (num_vertices > 0) {
                // v0 = (0,0,0)
                uint v0 = base_vertex_id + 0;
                gl_MeshVerticesEXT[v0].gl_Position = push_constants.matrix * vec4(vec3(ts_in.chunk_position) * 16.0 + vec3(block_pos) + vec3(0, 0, 0), 1.0);
                // v1 = (0,0,1)
                uint v1 = base_vertex_id + 1;
                gl_MeshVerticesEXT[v1].gl_Position = push_constants.matrix * vec4(vec3(ts_in.chunk_position) * 16.0 + vec3(block_pos) + vec3(0, 0, 1), 1.0);
                // v2 = (1,0,0)
                uint v2 = base_vertex_id + 2;
                gl_MeshVerticesEXT[v2].gl_Position = push_constants.matrix * vec4(vec3(ts_in.chunk_position) * 16.0 + vec3(block_pos) + vec3(1, 0, 0), 1.0);
                // v3 = (1,0,1)
                uint v3 = base_vertex_id + 3;
                gl_MeshVerticesEXT[v3].gl_Position = push_constants.matrix * vec4(vec3(ts_in.chunk_position) * 16.0 + vec3(block_pos) + vec3(1, 0, 1), 1.0);
                // v4 = (0,1,0)
                uint v4 = base_vertex_id + 4;
                gl_MeshVerticesEXT[v4].gl_Position = push_constants.matrix * vec4(vec3(ts_in.chunk_position) * 16.0 + vec3(block_pos) + vec3(0, 1, 0), 1.0);
                // v5 = (0,1,1)
                uint v5 = base_vertex_id + 5;
                gl_MeshVerticesEXT[v5].gl_Position = push_constants.matrix * vec4(vec3(ts_in.chunk_position) * 16.0 + vec3(block_pos) + vec3(0, 1, 1), 1.0);
                // v6 = (1,1,0)
                uint v6 = base_vertex_id + 6;
                gl_MeshVerticesEXT[v6].gl_Position = push_constants.matrix * vec4(vec3(ts_in.chunk_position) * 16.0 + vec3(block_pos) + vec3(1, 1, 0), 1.0);
                // v7 = (1,1,1)
                uint v7 = base_vertex_id + 7;
                gl_MeshVerticesEXT[v7].gl_Position = push_constants.matrix * vec4(vec3(ts_in.chunk_position) * 16.0 + vec3(block_pos) + vec3(1, 1, 1), 1.0);

                if ((faces & 0x1) != 0) {
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, 1, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v4, v7, v5);
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, 1, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v4, v6, v7);
                }
                if ((faces & 0x2) != 0) {
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, -1, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v0, v3, v2);
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, -1, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v0, v1, v3);
                }
                if ((faces & 0x4) != 0) {
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, 0, 1);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v1, v5, v7);
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, 0, 1);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v1, v7, v3);
                }
                if ((faces & 0x8) != 0) {
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, 0, -1);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v0, v6, v4);
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(0, 0, -1);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v0, v2, v6);
                }
                if ((faces & 0x10) != 0) {
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(1, 0, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v2, v3, v7);
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(1, 0, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v2, v7, v6);
                }
                if ((faces & 0x20) != 0) {
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(-1, 0, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v0, v5, v1);
                    colorOut[primitive_idx] = color;
                    normalOut[primitive_idx] = vec3(-1, 0, 0);
                    gl_PrimitiveTriangleIndicesEXT[primitive_idx++] = uvec3(v0, v4, v5);
                }
            }
        } else {
            break;
        }
//break;
    }
}