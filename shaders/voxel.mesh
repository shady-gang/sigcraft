#version 450
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(triangles, max_vertices = 192, max_primitives = 64) out;

layout(scalar, buffer_reference) buffer VoxelDataRef {
  uint data[];
};

struct ChunkSections {
    VoxelDataRef sections[24];
};

layout(scalar, buffer_reference) buffer VisibleChunksArrayRef {
    ChunkSections visible[];
};

layout(scalar, push_constant) uniform T {
    mat4 matrix;
    float time;
    ivec3 camera_chunk_pos;
    int debug;
    int visible_chunk_radius;
    VisibleChunksArrayRef visible_chunks;
} push_constants;

struct Payload {
    ivec3 chunk_position;
    uint16_t sub_chunk[64];
    uint64_t neighboring_chunks[27];
};

taskPayloadSharedEXT Payload ts_in;

layout(location = 0)
out vec4 colorOut[];

#define CUNK_CHUNK_MAX_HEIGHT 384
#define CUNK_CHUNK_SIZE 16

const uint lod_res[] = { 16, 8, 4, 2, 1 };
const uint lod_offsets[] = { 0, 4096, 4608, 4672, 4680, 4681 };

uint encode_chunkcoord(uint x, uint y, uint z, uint lod) {
    return lod_offsets[lod] + x + (y + z * lod_res[lod]) * lod_res[lod];
}

uint encode_chunkcoord(uvec3 v, uint lod) {
    return encode_chunkcoord(v.x, v.y, v.z, lod);
}

int world2chunk(int x) {
    if (x >= 0) return x / 16;
    return (x - 15) / 16;
}

ivec3 world2chunk(ivec3 v) {
    return ivec3(world2chunk(v.x), world2chunk(v.y), world2chunk(v.z));
}

int encode_neighboring_chunk_idx(int dx, int dy, int dz) {
    return ((dx + 1) * 3 + (dy + 1)) * 3 + (dz + 1);
}

uint lod_access(VoxelDataRef chunk, uvec3 pos, out int out_lod) {
    if (uint64_t(chunk) == 0)
        return 0;

    for (int lod = push_constants.debug == 3 ? 4 : 0; lod >= 0; lod--) {
        out_lod = lod;
        uvec3 lod_pos = pos / lod_res[4-lod];
        uint data = chunk.data[encode_chunkcoord(lod_pos, lod)];
        if (lod == 0) {
            return data;
        }
        if (data == 0)
            return 0;
        // completely filled
        if (data == 2)
            return 2;
    }
    // unreachable
    return 0;
}

uint safe_access(int x, int y, int z, out int out_lod) {
    int ox = 0, oy = 0, oz = 0;
    if (x >= 16) {
        ox = 1;
        x -= 16;
    }
    if (y >= 16) {
        oy = 1;
        y -= 16;
    }
    if (z >= 16) {
        oz = 1;
        z -= 16;
    }
    if (x < 0) {
        ox = -1;
        x += 16;
    }
    if (y < 0) {
        oy = -1;
        y += 16;
    }
    if (z < 0) {
        oz = -1;
        z += 16;
    }

    if (y < 0 || y >= CUNK_CHUNK_MAX_HEIGHT)
        return 0;

    if (x >= 0 && x < CUNK_CHUNK_SIZE && y >= 0 && z >= 0 && y < CUNK_CHUNK_SIZE && z < CUNK_CHUNK_SIZE) {
        VoxelDataRef voxel_data = VoxelDataRef(ts_in.neighboring_chunks[encode_neighboring_chunk_idx(ox, oy, oz)]);
        return lod_access(voxel_data, uvec3(x, y, z), out_lod);
    }
    //ivec3 chunk_pos = world2chunk(ivec3(x, y, z));
    //ivec3 delta = chunk_pos - push_constants.camera_chunk_pos;
    //if (abs(delta.x) >= push_constants.visible_chunk_radius || abs(delta.z) >= push_constants.visible_chunk_radius)
    //    return 0;

    return 0;
}

uint safe_access(ivec3 v, out int out_lod) {
    return safe_access(v.x, v.y, v.z, out_lod);
}

bool need_face(ivec3 pos, ivec3 delta, out int out_lod) {
    int dc;
    return (safe_access(pos, dc) != 0) && (safe_access(pos + delta, out_lod) == 0);
}

vec3 lod2color(int lod) {
    if (lod == 4)
        return vec3(0.0, 0.0, 1.0);
    if (lod == 3)
        return vec3(0.0, 1.0, 1.0);
    if (lod == 2)
        return vec3(1.0, 1.0, 0.0);
    if (lod == 1)
        return vec3(1.0, 0.75, 0.0);
    return vec3(1.0, 0.0, 0.0);
}

vec3 heatmap(float lod) {
    if (lod < 2)
        return vec3(0.0, 0.0, 1.0);
    if (lod < 4)
        return vec3(0.0, 1.0, 1.0);
    if (lod < 8)
        return vec3(1.0, 1.0, 0.0);
    if (lod < 16)
        return vec3(1.0, 0.75, 0.0);
    return vec3(1.0, 0.0, 0.0);
}

void unpack_subchunk_idx(uint16_t idx, out uint cx, out uint cy, out uint cz) {
    cx = uint(idx) & 0xFu;
    idx = idx >> uint16_t(4);
    cy = uint(idx) & 0xFu;
    idx = idx >> uint16_t(4);
    cz = uint(idx) & 0xFu;
    idx = idx >> uint16_t(4);
}

uint16_t pack_subchunk_idx(uint cx, uint cy, uint cz) {
    return uint16_t(((cz) << 4 | cy) << 4 | cx);
}

void main() {
    uint vertexCount = 192;
    uint triangleCount = 64;
    SetMeshOutputsEXT(vertexCount, triangleCount);

    uint workload = ts_in.sub_chunk[gl_WorkGroupID.x];
    uint16_t subchunk_idx = uint16_t(workload & 0xFFF);
    uint subchunk_lod = workload >> 12;
    uvec3 subchunk_pos;
    unpack_subchunk_idx(subchunk_idx, subchunk_pos.x, subchunk_pos.y, subchunk_pos.z);

    ivec3 block_pos = ivec3(gl_LocalInvocationID.xyz + subchunk_pos * 4);

    vec3 color = vec3(0.75);

    color *= (ts_in.chunk_position.y * 16.0 + block_pos.y) / 128.0;

    int lod;

    if (need_face(block_pos, ivec3(0, 1, 0), lod)) {
        gl_MeshVerticesEXT[gl_LocalInvocationIndex * 3 + 0].gl_Position = push_constants.matrix * vec4(vec3(ts_in.chunk_position) * 16.0 + block_pos + vec3(1.0, 0.0, 0), 1.0);
        gl_MeshVerticesEXT[gl_LocalInvocationIndex * 3 + 1].gl_Position = push_constants.matrix * vec4(vec3(ts_in.chunk_position) * 16.0 + block_pos + vec3(1.0, 0.0, 1), 1.0);
        gl_MeshVerticesEXT[gl_LocalInvocationIndex * 3 + 2].gl_Position = push_constants.matrix * vec4(vec3(ts_in.chunk_position) * 16.0 + block_pos + vec3(0.0, 0.0, 1), 1.0);
    } else {
        gl_MeshVerticesEXT[gl_LocalInvocationIndex * 3 + 0].gl_Position = vec4(0);
        gl_MeshVerticesEXT[gl_LocalInvocationIndex * 3 + 1].gl_Position = vec4(0);
        gl_MeshVerticesEXT[gl_LocalInvocationIndex * 3 + 2].gl_Position = vec4(0);
    }

    if (push_constants.debug == 1)
        color = vec3(block_pos) / 16.0;
    if (push_constants.debug == 2)
        color = lod2color(lod);
    if (push_constants.debug == 5)
        color = heatmap(float(gl_NumWorkGroups.x)*0.25);

    gl_PrimitiveTriangleIndicesEXT[gl_LocalInvocationIndex + 0] = uvec3(gl_LocalInvocationIndex * 3 + 0, gl_LocalInvocationIndex * 3 + 1, gl_LocalInvocationIndex * 3 + 2);

    colorOut[gl_LocalInvocationIndex * 3 + 0] = vec4(color, 1.0);
    colorOut[gl_LocalInvocationIndex * 3 + 1] = vec4(color, 1.0);
    colorOut[gl_LocalInvocationIndex * 3 + 2] = vec4(color, 1.0);
}