#version 450
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(scalar, buffer_reference) buffer VoxelDataRef {
    uint data[];
};

struct ChunkSections {
    VoxelDataRef sections[24];
};

layout(scalar, buffer_reference) buffer VisibleChunksArrayRef {
    ChunkSections visible[];
};

layout(scalar, push_constant) uniform T {
    mat4 matrix;
    float time;
    ivec3 camera_chunk_pos;
    int debug;
    int visible_chunk_radius;
    VisibleChunksArrayRef visible_chunks;
} push_constants;

struct Payload {
    ivec3 chunk_position;
    uint16_t sub_chunk[64];
    uint64_t neighboring_chunks[27];
};


uint64_t neighboring_chunks_2[27];

taskPayloadSharedEXT Payload ts_out;

int encode_neighboring_chunk_idx(int dx, int dy, int dz) {
    return ((dx + 1) * 3 + (dy + 1)) * 3 + (dz + 1);
}

void decode_neighboring_chunk_idx(int idx, out int dx, out int dy, out int dz) {
    dz = (idx % 3) - 1;
    dy = ((idx / 3) % 3) - 1;
    dx = ((idx / 3) / 3) - 1;
}

const uint lod_res[] = { 16, 8, 4, 2, 1 };
const uint lod_offsets[] = { 0, 4096, 4608, 4672, 4680, 4681 };

uint encode_chunkcoord(uint x, uint y, uint z, uint lod) {
    return lod_offsets[lod] + x + (y + z * lod_res[lod]) * lod_res[lod];
}

uint encode_chunkcoord(uvec3 v, uint lod) {
    return encode_chunkcoord(v.x, v.y, v.z, lod);
}

bool is_chunk_solid(VoxelDataRef chunk) {
    uint data = chunk.data[encode_chunkcoord(uvec3(0), 4)];
    return data == 2;
}

uint16_t pack_subchunk_idx(uint cx, uint cy, uint cz) {
    return uint16_t(((cz) << 4 | cy) << 4 | cx);
}

bool is_subchunk_full(VoxelDataRef chunk, uint sc_x, uint sc_y, uint sc_z) {
    if (uint64_t(chunk) == 0)
        return false;
    return chunk.data[encode_chunkcoord(uvec3(sc_x, sc_y, sc_z), 2)] == 2;
}

bool check_subchunk_full(int sc_rx, int sc_ry, int sc_rz) {
    int dcx = 0, dcy = 0, dcz = 0;
    if (sc_rx < 0) {
        dcx = -1;
        sc_rx += 4;
    }
    if (sc_ry < 0) {
        dcy = -1;
        sc_ry += 4;
    }
    if (sc_rz < 0) {
        dcz = -1;
        sc_rz += 4;
    }
    if (sc_rx >= 4) {
        dcx = 1;
        sc_rx -= 4;
    }
    if (sc_ry >= 4) {
        dcy = 1;
        sc_ry -= 4;
    }
    if (sc_rz >= 4) {
        dcz = 1;
        sc_rz -= 4;
    }
    VoxelDataRef c = VoxelDataRef(neighboring_chunks_2[encode_neighboring_chunk_idx(dcx, dcy, dcz)]);
    return is_subchunk_full(c, uint(sc_rx), uint(sc_ry), uint(sc_rz));
}

void main() {
    // gl_WorkGroupID
    int visible_chunks_array_size = push_constants.visible_chunk_radius * 2 + 1;
    uint visible_chunks_array_idx = gl_WorkGroupID.x * visible_chunks_array_size + gl_WorkGroupID.z;

    ivec3 visual_chunk_offset = ivec3(int(gl_WorkGroupID.x) - push_constants.visible_chunk_radius, gl_WorkGroupID.y, int(gl_WorkGroupID.z) - push_constants.visible_chunk_radius);
    ivec3 chunk_position = push_constants.camera_chunk_pos;
    //chunk_position.y = 0;
    chunk_position += visual_chunk_offset;

    uint section = gl_WorkGroupID.y;

    VoxelDataRef ptr = push_constants.visible_chunks.visible[visible_chunks_array_idx].sections[section];
    int occluded_direct_neighbors = 0;
    if (uint64_t(ptr) != 0) {
#define PARALLEL_NEIGHBORS_GATHER 0
#if PARALLEL_NEIGHBORS_GATHER
        int idx = int(gl_SubgroupInvocationID);
        if (idx < 27) {
            int dx, dy, dz;
            decode_neighboring_chunk_idx(idx, dx, dy, dz);
#else
        for (int dx = -1; dx <= 1; dx++)
        for (int dy = -1; dy <= 1; dy++)
        for (int dz = -1; dz <= 1; dz++) {
            int idx = encode_neighboring_chunk_idx(dx, dy, dz);
#endif
            ivec3 neighboring_chunk_position = chunk_position + ivec3(dx, dy, dz);
            if (neighboring_chunk_position.y < 0 || neighboring_chunk_position.y >= 24) {
                ts_out.neighboring_chunks[idx] = 0;
                neighboring_chunks_2[idx] = 0;
            } else {
                ivec3 delta = neighboring_chunk_position - push_constants.camera_chunk_pos;
                if (abs(delta.x) > push_constants.visible_chunk_radius || abs(delta.z) > push_constants.visible_chunk_radius) {
                    ts_out.neighboring_chunks[idx] = 0;
                    neighboring_chunks_2[idx] = 0;
                }
                else {
                    uint visible_chunks_array_neighbor_x = delta.x + push_constants.visible_chunk_radius;
                    uint visible_chunks_array_neighbor_z = delta.z + push_constants.visible_chunk_radius;
                    uint visible_chunks_array_neighbor_idx = visible_chunks_array_neighbor_x * visible_chunks_array_size + visible_chunks_array_neighbor_z;

                    VoxelDataRef chunk = push_constants.visible_chunks.visible[visible_chunks_array_idx].sections[section + dy];
                    ts_out.neighboring_chunks[idx] = uint64_t(chunk);
                    neighboring_chunks_2[idx] = uint64_t(chunk);

                    bool is_direct_neighbor = abs(dx) + abs(dy) + abs(dz) <= 1;
                    if (is_direct_neighbor) {
                        if (uint64_t(chunk) != 0 && is_chunk_solid(chunk))
                            occluded_direct_neighbors += 1;
                    }
               }
            }
        }

        //ts_out.neighboring_chunks[encode_neighboring_chunk_idx(0,0,0)] = uint64_t(ptr);

#if PARALLEL_NEIGHBORS_GATHER
        occluded_direct_neighbors = subgroupAdd(occluded_direct_neighbors);
#endif

        if (occluded_direct_neighbors < 7 || push_constants.debug == 4) {
            ts_out.chunk_position = chunk_position;

            int num_subchunks = 0;

            // use LOD 2
            for (int sc_x = 0; sc_x < 4; sc_x++)
            for (int sc_y = 0; sc_y < 4; sc_y++)
            for (int sc_z = 0; sc_z < 4; sc_z++) {
                uint data = ptr.data[encode_chunkcoord(uvec3(sc_x, sc_y, sc_z), 2)];
                if (data == 0)
                    continue;

                if (data == 2) {
                    // check if all the neighboring subchunks are also solid
                    if (check_subchunk_full(sc_x + 1, sc_y, sc_z)
                     && check_subchunk_full(sc_x - 1, sc_y, sc_z)
                     && check_subchunk_full(sc_x, sc_y + 1, sc_z)
                     && check_subchunk_full(sc_x, sc_y - 1, sc_z)
                     && check_subchunk_full(sc_x, sc_y, sc_z + 1)
                     && check_subchunk_full(sc_x, sc_y, sc_z - 1)) {
                        continue;
                    }
                }

                ts_out.sub_chunk[num_subchunks] = pack_subchunk_idx(sc_x, sc_y, sc_z);
                num_subchunks++;
            }
            EmitMeshTasksEXT(num_subchunks, 1, 1);
            return;
        }
    }
    // emit NOTHING
    EmitMeshTasksEXT(0, 0, 0);
}