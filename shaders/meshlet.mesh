#version 450
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_maximal_reconvergence : enable
#extension GL_EXT_debug_printf : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#define MAX_VERTS 64
#define MAX_PRIMS 126

layout(triangles, max_vertices = MAX_VERTS, max_primitives = MAX_PRIMS) out;

struct Meshlet {
    uint16_t num_verts;
    uint16_t num_faces;
    uint16_t face;
};

layout(scalar, buffer_reference) buffer MeshletRef {
    Meshlet ref;
};

layout(scalar, buffer_reference) buffer U32ArrayRef {
    uint32_t ref[];
};

layout(scalar, buffer_reference) buffer U8ArrayRef {
    uint8_t ref[];
};

struct Meshlets {
    uint32_t num_meshlets;
    uint32_t offsets[1];
};

layout(scalar, buffer_reference) buffer MeshletsRef {
    Meshlets ref;
};

struct Plane {
    vec3 normal;
    float distance;
};

struct Frustum {
    Plane planes[6];
};

layout(scalar, push_constant) uniform T {
    mat4 matrix;
    Frustum frustum;
    ivec3 camera_chunk_pos;
    vec3 camera_pos;
    vec3 camera_dir;
    float time;
    int debug;
    int visible_chunk_radius;
    uint64_t visible_chunks;
} push_constants;

struct Payload {
    ivec3 chunk_position;
    uint64_t tmp;
    uint32_t visible_meshlets_count;
    uint32_t masks[10];
};

taskPayloadSharedEXT Payload ts_in;

perprimitiveEXT out gl_MeshPerPrimitiveEXT {
    int gl_PrimitiveID;
    //int gl_Layer;
} gl_MeshPrimitivesEXT[];

layout(location = 0)
perprimitiveEXT out vec3 colorOut[];
//
// layout(location = 1)
// perprimitiveEXT out vec3 normalOut[];

#define CUNK_CHUNK_MAX_HEIGHT 384
#define CUNK_CHUNK_SIZE 16

vec3 lod2color(int lod) {
    if (lod == 4)
        return vec3(0.0, 0.0, 1.0);
    if (lod == 3)
        return vec3(0.0, 1.0, 1.0);
    if (lod == 2)
        return vec3(1.0, 1.0, 0.0);
    if (lod == 1)
        return vec3(1.0, 0.75, 0.0);
    return vec3(1.0, 0.0, 0.0);
}

vec3 heatmap(float lod) {
    if (lod < 2)
        return vec3(0.0, 0.0, 1.0);
    if (lod < 4)
        return vec3(0.0, 1.0, 1.0);
    if (lod < 8)
        return vec3(1.0, 1.0, 0.0);
    if (lod < 16)
        return vec3(1.0, 0.75, 0.0);
    return vec3(1.0, 0.0, 0.0);
}

uvec3 unpack_vertex_position(uint idx) {
    return uvec3(idx & 0x1Fu, (idx >> 10u), (idx >> 5u) & 0x1Fu);
}

void main() {
    MeshletsRef meshlets = MeshletsRef(ts_in.tmp);

    uint meshlet_idx = 0;
    uint consumed_bits = 0;

    uint target = gl_WorkGroupID.x + 1;

    for (uint i = 0; i < 10; i++) {
        uint count = bitCount(ts_in.masks[i]);
        if (consumed_bits + count < target) {
            consumed_bits += count;
            meshlet_idx += 32;
            //continue;
        } else {
            for (uint bit = 0; bit < 32 && consumed_bits < target; bit++) {
                if (((ts_in.masks[i] >> bit) & 0x1) != 0)
                    consumed_bits++;
                if (consumed_bits == target)
                    break;
                meshlet_idx++;
            }
            break;
        }
    }

    // for (uint bit_idx = 0; bit_idx < meshlets.ref.num_meshlets; bit_idx++) {
    //     if (((ts_in.masks[(bit_idx >> 5)] >> (bit_idx % 32)) & 0x1) != 0)
    //         consumed_bits++;
    //     if (consumed_bits == gl_WorkGroupID.x + 1) {
    //         break;
    //     }
    //     meshlet_idx++;
    // }

    //meshlet_idx = gl_WorkGroupID.x;

    if (meshlet_idx >= meshlets.ref.num_meshlets) {
        SetMeshOutputsEXT(0, 0);
        return;
    }

    // if (((ts_in.masks[gl_WorkGroupID.x / 32] >> gl_WorkGroupID.x) & 1) == 0u) {
    //     SetMeshOutputsEXT(0, 0);
    //     return;
    // }

    MeshletRef meshlet = MeshletRef(uint64_t(ts_in.tmp) + uint64_t(meshlets.ref.offsets[meshlet_idx]));
    SetMeshOutputsEXT(meshlet.ref.num_verts, meshlet.ref.num_faces * 2);
    //SetMeshOutputsEXT(0, 0);

    //debugPrintfEXT("hi %lx %d\n", uint64_t(ts_in.tmp), meshlets.ref.offsets[meshlet_idx]);

    uint lid = gl_LocalInvocationID.x;
    U32ArrayRef vertex_buffer = U32ArrayRef(uint64_t(meshlet) + 4 * 2 + 24);
    if (lid < meshlet.ref.num_verts) {
        uvec3 vertex = unpack_vertex_position(vertex_buffer.ref[lid]);
        gl_MeshVerticesEXT[lid].gl_Position = push_constants.matrix * vec4(vec3(ts_in.chunk_position) + vertex, 1.0);
    }

    U8ArrayRef index_buffer = U8ArrayRef(uint64_t(meshlet) + 4 * 2 + 24 + 4 * uint64_t(meshlet.ref.num_verts));
    uint face = meshlet.ref.face;
    if (lid < meshlet.ref.num_faces) {
        uint v0 = uint(index_buffer.ref[lid * 8 + 0]);
        uint v1 = uint(index_buffer.ref[lid * 8 + 1]);
        uint v2 = uint(index_buffer.ref[lid * 8 + 2]);
        uint v3 = uint(index_buffer.ref[lid * 8 + 3]);

        vec3 color = vec3(index_buffer.ref[lid * 8 + 4], index_buffer.ref[lid * 8 + 5], index_buffer.ref[lid * 8 + 6]) / 255.0;

        //uint face = uint(index_buffer.ref[lid * 8 + 7]);
        uint base_primitive_idx = gl_WorkGroupID.x << 20;
        if (push_constants.debug == 2) {
            base_primitive_idx = (ts_in.visible_meshlets_count) << 3;
        }
        if (push_constants.debug == 3) {
            base_primitive_idx = (meshlet.ref.num_faces) << 3;
        }
        if (push_constants.debug == 4) {
            base_primitive_idx = (meshlet.ref.num_verts) << 3;
        }
        gl_MeshPrimitivesEXT[lid * 2 + 0].gl_PrimitiveID = int(base_primitive_idx | face);
        gl_MeshPrimitivesEXT[lid * 2 + 1].gl_PrimitiveID = int(base_primitive_idx | face);
        gl_PrimitiveTriangleIndicesEXT[lid * 2 + 0] = uvec3(v0, v2, v3);
        gl_PrimitiveTriangleIndicesEXT[lid * 2 + 1] = uvec3(v0, v3, v1);
        colorOut[lid * 2 + 0] = color;
        colorOut[lid * 2 + 1] = color;
    }
}